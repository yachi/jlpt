{
  "name": "jlpt-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline Android (Capacitor) front end for the JLPT study core in ../src.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "6.1.0",
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.10",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4",
    "sql.js": "1.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@types/node": "22.20.5",
    "@types/sql.js": "1.4.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.5"
  }
}
