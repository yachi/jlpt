<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch-window background shown before the WebView paints (pre-Android 12;
  12+ uses windowSplashScreen* in styles.xml). Replaces Capacitor's per-density
  splash PNGs with the icon's own colour and glyph.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:width="216dp"
        android:height="216dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
